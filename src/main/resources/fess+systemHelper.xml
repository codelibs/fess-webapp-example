<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE components PUBLIC "-//DBFLUTE//DTD LastaDi 1.0//EN"
	"http://dbflute.org/meta/lastadi10.dtd">
<!--
	OVERRIDE convention (single "+"):

	A classpath resource named "<baseDicon>+<componentName>.xml" tells LastaDi to
	REPLACE the component named <componentName> that "<baseDicon>.xml" declares.
	Fess declares "systemHelper" in its "fess.xml", so this file
	(fess+systemHelper.xml) replaces the core systemHelper with the subclass
	below. Contrast this with the additive "app++.xml" in this plugin, which ADDS
	a brand-new component instead of replacing an existing one.

	IMPORTANT: a redefine replaces the ENTIRE component definition, so it must
	repeat every property and postConstruct that Fess core declares for the
	component. Fess 15.9 declares none for systemHelper, so this override has
	none either. Check fess.xml of the Fess release you build against and keep
	this file in step with it. That maintenance cost is the main reason to prefer
	adding a new component (app++.xml) whenever you do not truly need to replace
	core behavior.
-->
<components>
	<component name="systemHelper"
		class="org.codelibs.fess.webapp.example.helper.CustomSystemHelper">
	</component>
</components>
